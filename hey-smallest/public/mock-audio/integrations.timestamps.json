{
 "id": "integrations",
 "question": "How do I use Smallest with Pipecat or LiveKit?",
 "voice": "meher",
 "model": "lightning_v3.1_pro",
 "sample_rate": 24000,
 "durationSec": 28.36925,
 "narration": "Pipecat and LiveKit use one API key for Smallest. Pipecat sends audio to the Pulse live socket and a finalize message when the turn ends. Speech goes out on the Lightning live socket. One turn shares a context_id. Set continue to true on each fragment, then false on the last. LiveKit loads the smallestai plugin, with STT model pulse for streaming. The model pulse-pro is pre recorded only. Keep phone audio at 8000 hertz.",

# User API key from https://app.smallest.ai/dashboard/settings/apikeys
# Mints wat_ tokens and calls Electron. Never expose it to the browser.
SMALLEST_API_KEY=

# Admin-role key. The demo does not send it: POST /console/v1/auth/token
# rejects admin keys, and narration uses SMALLEST_API_KEY. Kept here so a
# host can wire Atoms admin routes later without renaming the contract.
SMALLEST_ADMIN_API_KEY=

# Comma-separated browser origins allowed to call /api/token and /api/narrate.
# Exact origins and a single wildcard label are allowed. A bare * is ignored.
ALLOWED_ORIGINS=https://docs.smallest.ai,https://*.docs.buildwithfern.com

# Optional. Milliseconds per character for mock-mode playback. Default 22.
# NEXT_PUBLIC_MOCK_MS_PER_CHAR=22
